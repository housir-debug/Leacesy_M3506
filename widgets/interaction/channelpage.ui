  <property name="styleSheet">
   <string notr="true">*{
	font-family: &quot;WenQuanYi Micro Hei&quot;;
	border: none;
}#channelpage {
	background-color: #0A1220;
}

#channelpage #logosub_label,
#channelpage #phone_label,
#channelpage #email_label{
	background: transparent;
	font-size: 12px;
	font-weight: bold;
	color: #9CB8E8;
}#channelpage #logo_label{
	background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #172847,stop:1 #0E1B33);
	border-bottom-right-radius: 18px;
}#channelpage #page_label{
	background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #122032,stop:1 #0C1A2E);
	font-weight: bold;
	font-size: 16px;
	color: #E6EDF7;
	border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}#channelpage #botnaviga_frame{
	background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #172847,stop:1 #0E1B33);
	border-top-left-radius: 18px;
    border-top-right-radius: 18px;
}

#channelpage #ch_stackedWidget{
	border: 1.8px solid #304b82;
	border-radius: 12px;
}

#channelpage QProgressBar {
    background-color: #0E1B33;
    border: 1.2px solid #243B66;
    border-radius: 9px;
    font-weight: bold;
	font-size: 12px;
	color: #E6EDF7;
}#channelpage QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,stop:0 #2f7de0, stop:1 #34b979);
	border-radius: 6px;
	margin: 2.7px;
}

#channelpage QPushButton{
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,stop:0 #1A2D50, stop:1 #142442);
    border: 1.2px solid #304b82;
    border-radius: 9px;
    font-weight: bold;
	font-size: 12px;
	color: #9CB8E8;
}#channelpage QPushButton:checked{
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,stop:0 #243c69, stop:1 #1c325b);
    border-color: #4269ad;
    color: #E6EDF7;
}#channelpage QPushButton:pressed{
    background: #195c3c;
    border-color: #37b677;
    color: #ffffff;
}#channelpage QPushButton:disabled{
    background: #111928;
    border: 1px solid #202b40;
    color: #445470;
}

#channelpage #mode_frame{
	background-color: #0E1A2E;
	border: 1.2px solid #304b82;
	border-radius: 9px;
}#channelpage #mode_frame QPushButton {
	background-color: transparent; 
    border: none;
    font-weight: bold;
	font-size: 12px;
	color: #6A7288; 
}#channelpage #mode_frame QPushButton:checked{
    background-color: rgba(255, 255, 255, 0.04);
	color: #B0B8C5;
}</string>
