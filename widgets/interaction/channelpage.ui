  <property name="styleSheet">
   <string notr="true">*{
	font-family: &quot;WenQuanYi Micro Hei&quot;;
	background-color: #0A1220;
	border: none;
}

#logo_label{background: transparent;}

#topnaviga_frame,#botnaviga_frame{
	background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #172847,stop:1 #0E1B33);
}

QPushButton{
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #1A2D50, stop:1 #142442);
    border: 1px solid #304b82;
    border-radius: 6px;
    color: #9CB8E8;
    font-size: 13px;
    font-weight: bold;
    padding: 4px 9px;
}
QPushButton:hover,QPushButton:checked{
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #243c69, stop:1 #1c325b);
    border-color: #4269ad;
    color: #E6EDF7;
}
QPushButton:pressed{
    background: #195c3c;
    border-color: #37b677;
    color: #ffffff;
}
QPushButton:disabled{
    background: #111928;
    border: 1px solid #202b40;
    color: #445470;
}
#next_pushButton,#pre_pushButton{
    border-radius:16px;
    font-size:18px;
}
#mode_frame{
	background-color: #0E1A2E;
	border: 1px solid #1E2E4A;
	border-radius: 10px;
	padding: 3px;
}
#mode_frame QPushButton {
	background-color: transparent; 
    border: none;
    border-radius: 8px;  
    color: #6A7288; 
    font-size: 13px;
    font-weight: bold;
    padding: 4px 9px;
}
#mode_frame QPushButton:checked{
    color: #B0B8C5;
    background-color: rgba(255, 255, 255, 0.04);
}

QProgressBar {
    background-color: #0E1B33;
    border: 1px solid #243B66;
    border-radius: 8px;
    text-align: center;
    color: #E6EDF7;
    font-size: 12px;
    font-weight: bold;
    min-height: 16px;
    max-height: 16px;
}
QProgressBar::chunk {
    border-radius: 7px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #2f7de0, stop:1 #34b979);
}
</string>
