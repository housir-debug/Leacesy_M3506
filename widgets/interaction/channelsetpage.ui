  <property name="styleSheet">
   <string notr="true">* {
    font-family: &quot;WenQuanYi Micro Hei&quot;;
	border: none;
}#channelsetting{
	background-color: #0A1220;
}

#channelsetting #page_label {
	background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #122032,stop:1 #0C1A2E);
	font-weight: bold;
	font-size: 18px;
	color: #E6EDF7;
	border-bottom-left-radius: 27px;
    border-bottom-right-radius: 27px;
}#channelsetting #softver_label,
#channelsetting #hardver_label{
	background: transparent;
	font-size: 12px;
	font-weight: bold;
	color: #9CB8E8;
}#channelsetting #back_pushButton{
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,stop:0 #1A2D50, stop:1 #142442);
	border: 1.2px solid #34528c;
    font-weight: bold;
	font-size: 16px;
	color: #9CB8E8;
	border-top-right-radius: 12px;
	border-bottom-left-radius: 12px;
	border-bottom-right-radius: 27px;
}

#channelsetting #chselectframe,
#channelsetting #frame_3{
    background-color: #101C30;
    border: 1.8px solid #1E2E4A; 
    border-radius: 9px;
}#channelsetting QLabel{
	background: #111928;
	border-radius: 9px;
	font-weight: bold;
	font-size: 12px;
	color: #9CB8E8;
}#channelsetting #chselectframe QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,stop:0 #16294C, stop:1 #10203D);
    border: 1px solid #304b82;
    border-radius: 9px;
    font-weight: bold;
	font-size: 14px;
	color: #808090;
}#channelsetting #chselectframe QPushButton:checked,
#channelsetting #chselectframe QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,stop:0 #2A4A7A, stop:1 #1E3A62);
    border: 1.8px solid #4269ad;
    color: #FFFFFF;
}#channelsetting #chselectframe QPushButton:disabled {
    background: #111928;
    border: 1px solid #202b40;
    color: #445470;
}

#channelsetting #frame_3 QComboBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #1A2D50, stop:1 #142442);
    border: 1px solid #304b82;
    border-radius: 6px;
    color: #9CB8E8;
    font-size: 14px;
    font-weight: bold;
}#channelsetting #frame_3 QComboBox:disabled {
    background: #111928;
    border: 1px solid #202b40;
    color: #445470;
}#channelsetting #frame_3 QComboBox::drop-down {
    background: transparent;
}#channelsetting #frame_3 QComboBox QAbstractItemView {
    background-color: #142442;
    border: 1px solid #304b82;
    border-radius: 9px;
    font-weight: bold;
	font-size: 14px;
	color: #9CB8E8;
    outline: none;
    selection-background-color: #2A4A7A;
    selection-color: #FFFFFF;
}#channelsetting #frame_3 QComboBox QAbstractItemView::item {
    background: transparent;
 	border-radius: 6px;
	color: #9CB8E8;
	min-height: 27px;
    padding: 2px 8px;
}#channelsetting #frame_3 QComboBox QAbstractItemView::item:selected {
    background-color: #2A4A7A;
    color: #FFFFFF;
}#channelsetting #frame_3 #onoff_comboBox{
    color: #e65454;
    border-color: #702424;
}#channelsetting #frame_3 #onoff_comboBox[Outputed=true]{
    color: #34b979;
    border-color: #1f5c40;
}

#channelsetting #frame_3 #frame_2,
#channelsetting #frame_3 #frame{
	background-color: #0E1A2E;
	border: 1.2px solid #304b82;
	border-radius: 9px;
}#channelsetting #frame_3  #frame QPushButton {
	background-color: transparent; 
	border-radius: 9px;
    font-weight: bold;
	font-size: 12px;
	color: #6A7288; 
}#channelsetting #frame_3  #frame QPushButton:checked{
    background-color: rgba(255, 255, 255, 0.04);
	color: #B0B8C5;
}

#channelsetting #keyframe {
    background-color: #101C30;
    border: 1px solid #1E2E4A; 
    border-radius: 16px;
}</string>
