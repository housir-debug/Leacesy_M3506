  <property name="styleSheet">
   <string notr="true">* {
    font-family: &quot;WenQuanYi Micro Hei&quot;;
    background-color: #0A1220;
}

#channelsetting QComboBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #1A2D50, stop:1 #142442);
    border: 1px solid #304b82;
    border-radius: 6px;
    color: #9CB8E8;
    font-size: 14px;
    font-weight: bold;
}
#channelsetting QComboBox:disabled {
    background: #111928;
    border: 1px solid #202b40;
    color: #445470;
}
#channelsetting QComboBox::drop-down {
    background: transparent;
}

#channelsetting QComboBox QAbstractItemView {
    background-color: #142442;
    border: 1px solid #304b82;
    border-radius: 9px;
    font-weight: bold;
	font-size: 14px;
	color: #9CB8E8;
    /*padding: 6px;*/
    outline: none;
    selection-background-color: #2A4A7A;
    selection-color: #FFFFFF;
}
#channelsetting QComboBox QAbstractItemView::item {
    background: transparent;
 	border-radius: 6px;
	color: #9CB8E8;
	min-height: 27px;
    padding: 2px 8px;
}
#channelsetting QComboBox QAbstractItemView::item:selected {
    background-color: #2A4A7A;
    color: #FFFFFF;
}

#channelsetting QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,stop:0 #1A2D50, stop:1 #142442);
    border: 1px solid #304b82;
    border-radius: 9px;
    font-weight: bold;
	font-size: 14px;
	color: #9CB8E8;
}
#channelsetting QPushButton:pressed {
    background: #195c3c;
    border-color: #37b677;
    color: #ffffff;
}
#channelsetting QPushButton:disabled {
    background: #111928;
    border: 1px solid #202b40;
    color: #445470;
}

#page_label {
    background: transparent;
    border: none;
	font-weight: bold;
	font-size: 18px;
	color: #E6EDF7;
}
#frame_5,
#frame_6 {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,stop:0 #172847, stop:1 #0E1B33);
 	border-radius: 12px;
    border: none;
}

#chselectframe,
#frame_3,
#keyframe {
    background-color: #101C30;
    border: 1px solid #1E2E4A; 
    border-radius: 16px;
}
#chselectframe QPushButton {
    color: #808090;
}
#frame_3 QPushButton:checked,#chselectframe QPushButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,stop:0 #2A4A7A, stop:1 #1E3A62);
    border: 1px solid #4269ad;
    color: #FFFFFF;
}

#onoff_comboBox{
    color: #e65454;
    border-color: #702424;
}
#onoff_comboBox[Outputed=true]{
    color: #34b979;
    border-color: #1f5c40;
}</string>
  </property>
