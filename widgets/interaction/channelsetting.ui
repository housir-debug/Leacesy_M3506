  <property name="styleSheet">
   <string notr="true">*{
	font-family: &quot;WenQuanYi Micro Hei&quot;;
	background-color: #0A1220;
	border: none;
}

#chselectframe
{
	background-color: #101C30;
	border-radius: 18px;
	border: 3px solid rgba(63, 63, 90, 0.81);
}
#chselectframe QPushButton {
	border: 2px solid rgba(63, 63, 90, 0.81);
	border-radius: 9px;
    color: #808090;
    font-size: 18px;
}
#chselectframe QPushButton:pressed {
    background-color: #0D1525;
    border: 2px solid rgba(100, 100, 130, 1.0);
    color: #FFFFFF;
}
#chselectframe QPushButton:checked {
    background-color: #243356;
    border: 2px solid rgba(100, 100, 130, 0.9);
    color: #E0E0E0;
}</string>
