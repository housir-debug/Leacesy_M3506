  <property name="windowTitle">
   <string>Device Settings</string>
  </property>
  <property name="styleSheet">
   <string notr="true">*{
	font-family: &quot;WenQuanYi Micro Hei&quot;;
	background-color: #0A1220;
	border: none;
}

#devicesetpage QComboBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #1A2D50, stop:1 #142442);
    border: 1px solid #304b82;
    border-radius: 6px;
    color: #9CB8E8;
    font-size: 14px;
    font-weight: bold;
}
#devicesetpage QComboBox:disabled {
    background: #111928;
    border: 1px solid #202b40;
    color: #445470;
}
#devicesetpage QComboBox::drop-down {
    background: transparent;
}
#devicesetpage QComboBox QAbstractItemView {
    background-color: #142442;
    border: 1px solid #304b82;
    border-radius: 9px;
    font-weight: bold;
	font-size: 14px;
	color: #9CB8E8;
    outline: none;
    selection-background-color: #2A4A7A;
    selection-color: #FFFFFF;
}
#devicesetpage QComboBox QAbstractItemView::item {
    background: transparent;
 	border-radius: 6px;
	color: #9CB8E8;
	min-height: 27px;
    padding: 2px 8px;
}
#devicesetpage QComboBox QAbstractItemView::item:selected {
    background-color: #2A4A7A;
    color: #FFFFFF;
}

#devicesetpage QRadioButton {
    background: transparent;
 	font-weight: bold;
 	font-size: 14px;
	color: #8A90A0;
}
#devicesetpage QRadioButton:disabled {
    color: #4A4E5A;
}
#devicesetpage QRadioButton::indicator {
    background-color: #151D2E;
	border: 2px solid #3A3E50;
	border-radius: 8px;
	height: 12px;
	width: 12px;
}
#devicesetpage QRadioButton::indicator:checked {
    background-color: #288A78;
}
#devicesetpage QRadioButton::indicator:disabled {
    background-color: #0A0F16;
	border: 2px solid #252836;
}

#devicesetpage QPushButton{
    background-color: rgba(40, 65, 110, 0.45);
    border: 1px solid #34528c;
    border-radius: 9px;
    font-weight: bold;
	font-size: 14px;
	color: #9CB8E8;
}
#devicesetpage QPushButton:pressed {
    background-color: #195c3c;
    border-color: #37b677;
}
#devicesetpage QPushButton:disabled {
    background-color: rgba(28, 32, 44, 0.35);
    border: 1px solid #42485c;
    color: #646e82;
}

#devicesetpage #page_label {
	background: transparent;
    border: none;
    font-weight: bold;
	font-size: 18px;
	 color: #E6EDF7;
}
#devicesetpage #top_frame,
#devicesetpage #bot_frame {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,stop:0 #172847, stop:1 #0E1B33);
    border: none;
    border-radius: 12px;
}
#devicesetpage #mac_label, 
#devicesetpage #hard_label, 
#devicesetpage #soft_label {
    background: transparent;
    border: none;
	font-size: 15px;
	color: #808090;
}
#devicesetpage #macaddress_label, 
#devicesetpage #hardver_label, 
#devicesetpage #softver_label {
    background: transparent;
    border: none;
	font-weight: bold;
	font-size: 14px;
	color: #D0D0D0;
}

#devicesetpage #LAN_frame,
#devicesetpage #other_frame,
#devicesetpage #keyframe {
    background-color: #0E1A2E;
    border: 1px solid #1E2E4A;
    border-radius: 14px;
}
#devicesetpage #LANbut_frame {
    background-color: #142442;
    border: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}
#devicesetpage #settingLANlabel {
    color: #C0C8D5;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
    border: none;
}
#devicesetpage #other_label {
	background-color: #142442;
	border: none;
    font-weight: bold;
	font-size: 18px;
	color: #C0C8D5;
	border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

#devicesetpage #net_frame {
    background-color: #0E1A2E; 
    border: 1px solid #1E2E4A;
    border-radius: 9px;
}
#devicesetpage #net_frame QPushButton {
    background-color: transparent; 
    border: none;
    border-radius: 9px; 
    font-weight: bold;
	font-size: 14px;
	color: #6A7288; 
}
#devicesetpage #net_frame QPushButton:checked{
    background-color: rgba(255, 255, 255, 0.04);
	color: #B0B8C5;
}

#devicesetpage #networkframe,
#devicesetpage #deviceidframe  {
    background-color: #111B2C;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}
#devicesetpage #iplabel, 
#devicesetpage #masklabel, 
#devicesetpage #gatelabel ,
#devicesetpage #canidlabel, 
#devicesetpage #canbaudlabel, 
#devicesetpage #rs232baudlabel {
    color: #E0E8F0;
	font-size: 14px;
    background-color: #1A2840;
    border: 1px solid rgba(90, 180, 160, 0.35);
    border-radius: 6px;
}</string>
