  </property>
  <property name="styleSheet">
   <string notr="true">*{
	font-family: &quot;WenQuanYi Micro Hei&quot;;
	background-color: #0A1220;
}

QPushButton{
    color: #9CB8E8;
    background-color: rgba(40, 65, 110, 0.45);
    border: 1px solid #34528c;
    border-radius: 9px;
    font-size: 15px;
    font-weight: bold;
    padding: 3px 18px;
    min-width: 72px;
}
QPushButton:hover {
    background-color: rgba(55, 88, 145, 0.65);
    border-color: #476fb8;
    color: #FFFFFF;
}
QPushButton:pressed {
    background-color: #195c3c;
    border-color: #37b677;
}
QPushButton:disabled {
    background-color: rgba(28, 32, 44, 0.35);
    border: 1px solid #42485c;
    color: #646e82;
}


#net_frame {
    background-color: #0E1A2E; 
    border: 1px solid #1E2E4A;
    border-radius: 10px;
    padding: 3px;  
}
#net_frame QPushButton {
    background-color: transparent; 
    border: none;
    border-radius: 8px; 
    color: #6A7288; 
    font-size: 14px;
    font-weight: bold;
    padding: 3px 18px;
    min-width: 64px;
}
#net_frame QPushButton:checked{
    color: #B0B8C5;
    background-color: rgba(255, 255, 255, 0.04);
}


QRadioButton {
    color: #8A90A0;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}
QRadioButton::indicator {
    width: 12px;
    height: 12px;
    border-radius: 8px;
    border: 2px solid #3A3E50;
    background-color: #151D2E;
}
QRadioButton::indicator:checked {
    background-color: #288A78;
}
QRadioButton:disabled {
    color: #4A4E5A;
}
QRadioButton::indicator:disabled {
    border: 2px solid #252836;
    background-color: #0A0F16;
}


#LAN_frame,#other_frame {
    background-color: #0E1A2E;
    border: 1px solid #1E2E4A;
    border-radius: 14px;
}
#LANbut_frame {
    background-color: #142442;
    border: none;
    border-bottom: 1px solid #1E2E4A;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    padding: 4px 8px;
}
#other_label {
	background-color: #142442;
	border: none;
	border-bottom: 1px solid #1E2E4A;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
 	padding: 4px 8px;
    color: #C0C8D5;
    font-size: 18px;
    font-weight: bold;
}
#settingLANlabel {
    color: #C0C8D5;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
    border: none;
    padding-left: 4px 8px;
}
#networkframe,#deviceidframe  {
    background-color: #111B2C;
    border: 1px solid rgba(70, 70, 100, 0.45);
    border-radius: 12px;
    margin: 6px 10px;
    padding: 6px;
}
#iplabel, #masklabel, #gatelabel ,#canidlabel, #canbaudlabel, #rs232baudlabel {
    color: #E0E8F0;
	font-size: 14px;
    background-color: #1A2840;
    border: 1px solid rgba(90, 180, 160, 0.35);
    border-radius: 6px;
    padding: 2px 8px;
    min-height: 22px;
}


#top_frame,#bot_frame {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #172847, stop:1 #0E1B33);
    border: none;
    border-bottom: 1px solid #243B66;
    border-radius: 12px;
}
#page_label {
    color: #E6EDF7;
    font-size: 22px;
    font-weight: bold;
    background: transparent;
    border: none;
    padding-left: 12px;
}
#mac_label, #hard_label, #soft_label {
    color: #808090;
    font-size: 15px;
    background: transparent;
    border: none;
}
#macaddress_label, #hardver_label, #softver_label {
    color: #D0D0D0;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
    border: none;
}</string>
