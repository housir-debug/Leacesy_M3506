              <string notr="true">#deviceidframe {
    background-color: #111B2C;
    border-radius: 18px;
    border: 2px solid rgba(70, 70, 100, 0.5);
}

#deviceidframe QRadioButton {
    color: #8A90A0;
    font-size: 12px;
    font-weight: bold;
}

#deviceidframe QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 9px;
    border: 2px solid #3A3E50;
    background-color: #151D2E;
}

#deviceidframe QRadioButton::indicator:checked {
    background-color: #288A78;
}

#deviceidframe QRadioButton:disabled {
    color: #4A4E5A; 
	background: transparent;
}

#deviceidframe QRadioButton::indicator:disabled {
	border: 2px solid #252836;
    background-color: #0A0F16;
}

#deviceidframe QLabel {
    color: #B0B8C5;
    font-size: 16px;
}

#canidvaluelabel, #gpibvaluelabel {
    color: #E0E8F0;
    background-color: #1A2840;
    border: 1px solid rgba(90, 180, 160, 0.3);
    border-radius: 6px;
}
</string>
