    color: #808090;
    font-size: 18px;
    font-weight: bold;
    spacing: 9px;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 11px;
    border: 2px solid #3A3A50;
    background-color: #151D2E;
}
QRadioButton:checked {
    color: #60C8B0;
}
QRadioButton:indicator::checked{
	background-color: #2A8A7A;
}
QLabel {
    color: #C9C9C9;
    font-size: 16px;
    border: none;
}
#cvvaluelabel, #ccvaluelabel, #ovpvaluelabel {
    color: #D0D0D0;
    font-size: 18px;
    background-color: #151D2E;
    border: 1px solid #2A2A3E;
    border-radius: 9px;
    padding: 6px;
}</string>
