 	color: #D0D0D0;
}

#socprogressBar{
   font-weight: bold;
   color: #5A5A6A;
   font-size: 18px;
	border: 6px solid rgba(90,100,125,0.32);
	border-radius: 6px;
	background: rgba(255,255,255,0.04);
}
#socprogressBar::chunk {
   margin: 1px;
	border-radius: 6px;
}

#modelframe
{
 background: rgba(255, 255, 255, 0.036);
border: 1px solid #2A2A3A;
border-radius: 9px;
}
#modellabel,#modelnamelabel
{
font-size: 12px;
color: #C9C9C9;
}</string>
