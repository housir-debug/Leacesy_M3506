   <property name="styleSheet">
    <string notr="true">#measureframe{
	background-color: #080810;
  	border-radius: 9px;
 	border: 1.2px solid #3A3A4E;
}#curr_label{
	font-weight: bold;
	font-size: 32px;
	color: #D23040;
}#currunit_label{
	font-size: 16px;
	color: #D23040;
}#volt_label{
	font-weight: bold;
	font-size: 32px;
	color: #10B870;
}#voltunit_label{
	font-size: 16px;
	color: #10B870;
}

#cv_frame ,
#cc_frame,
#ovp_frame{ 
    background-color: rgba(255,255,255,0.035);
    border: 1px solid rgba(90,100,125,0.32);
	border-radius:12px;
}#cv_frame QLabel,
#cc_frame QLabel,
#ovp_frame QLabel{
	font-size: 12px;
	color: #C9C9C9;
}
#cv_frame[Status=true] { 
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(13, 175, 101, 0.36),
        stop:1 rgba(13, 175, 101, 0.12));
    border: 1.2px solid rgba(13,175,101,0.84);
}#cc_frame[Status=true] { 
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(223, 29, 50, 0.36),
        stop:1 rgba(223, 29, 50, 0.12));
    border: 1.2px solid rgba(223, 29, 50, 0.84);
}#ovp_frame[Status=true] { 
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(229, 194, 125, 0.36),
        stop:1 rgba(229, 194, 125, 0.12));
    border: 1.2px solid rgba(229, 194, 125, 0.84);
}</string>
