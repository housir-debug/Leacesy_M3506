   <property name="styleSheet">
    <string notr="true">#socprogressBar{
	background: rgba(255,255,255,0.04);
	border: 2.4px solid rgba(90,100,125,0.32);
	border-radius: 6px;
   font-weight: bold;
	font-size: 18px;
   color: #5A5A6A;
}#socprogressBar::chunk {
	border-radius: 6px;
   margin: 2.7px;
}#socprogressBar[Power=&quot;high&quot;]::chunk {
	background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0 #00C696,stop:1 #0DAF65
    );
}#socprogressBar[Power=&quot;mid&quot;]::chunk {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0 #B88C2E,stop:1 #94681A
    );
}#socprogressBar[Power=&quot;low&quot;]::chunk {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0 #A83238, stop:1 #822025
    );
}

#ocvframe,
#esrframe,
#capframe{
	background: rgba(255,255,255,0.036);
	border: 1px solid rgba(90,100,125,0.32);
	border-radius: 6px;
}#caplabel,
#esrlabel,
#ocvlabel{
	font-size: 9px;
	color: #C9C9C9;
}#capvaluelabel,
#esrvaluelabel,
#ocvvaluelabel{
	font-size: 18px;
 	color: #D0D0D0;
}

#modelframe{
 	background: rgba(255, 255, 255, 0.036);
	border: 1.8px solid #2A2A3A;
	border-radius: 9px;
}#modelframe QLabel{
	font-size: 12px;
	color: #C9C9C9;
}</string>
