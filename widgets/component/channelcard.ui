  <property name="styleSheet">
   <string notr="true">* {
	font-family:&quot;WenQuanYi Micro Hei&quot;;
	background-color: transparent;
}

#channelcard &gt; QWidget{
    background-color: #101C30;
    border: 1.8px solid rgba(63, 63, 90, 0.81);
	border-radius: 18px;
}
#channelcard[Outputed=true] &gt; QWidget{
    background-color: #1A2A45;
    border-color: rgba(100, 100, 130, 0.9);
}

#channelcard #digitalch_label,
#channelcard #versionch_label,
#channelcard #batterych_label,
#channelcard #statusch_label{
	font-weight: bold;
	font-size: 36px;
	color: #C9C9C9;
}</string>
  </property>
