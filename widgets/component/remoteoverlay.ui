}

#remoteoverlay QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,stop:0 #1A2D50, stop:1 #142442);
    border: 1px solid #304b82;
    border-radius: 9px;
    font-weight: bold;
	font-size: 18px;
	color: #9CB8E8;
	padding-top:9px;
    padding-bottom:9px;
}#remoteoverlay QPushButton:pressed {
    background: #195c3c;
    border-color: #37b677;
    color: #ffffff;
}#remoteoverlay QPushButton:disabled {
    background: #111928;
    border: 1px solid #202b40;
    color: #445470;
}</string>
